<?xml version="1.0"?> <!-- 这是版本提示 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find robot_description)/urdf/light_robot/common_inertia.xacro"/>

    <xacro:macro name ="base_xacro" params="length radius">
        <!-- 虚拟部件，使机器贴合地面 -->
        <link name="base_footprint"/>
        <!-- 机器人的身体 -->
        <link name="base_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 -->
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!-- 材质颜色 -->
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.5"/>
                </material>
            </visual>
            <collision>
                    <!-- 沿着自己几何中心偏移和旋转 -->
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <!-- 几何形状 -->
                    <geometry>
                        <!-- 圆柱体 -->
                        <cylinder radius="${radius}" length="${length}"/>
                    </geometry>
            </collision>

            <xacro:cylinder_inertia m = "1.0" r="${radius}" h="${length}" />
        </link>

        <joint name="joint_name" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${length/2.0 + 0.032 - 0.001}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>