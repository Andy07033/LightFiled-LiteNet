<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_sensor_plugin" params="index">
        <gazebo reference="camera_${index}_link">
            <sensor name="camera_${index}_sensor" type="camera">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <camera name="camera_${index}">
                    <horizontal_fov>1.5009831567</horizontal_fov>
                    <image>
                        <width>512</width>
                        <height>512</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.02</near>
                        <far>50</far>
                    </clip>
                </camera>
                <plugin name="camera_${index}_plugin" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>/</namespace>
                    </ros>
                    <camera_name>camera_${index}</camera_name>
                    <frame_name>camera_${index}_optical_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="gazebo_sensor_plugins">
        <xacro:gazebo_sensor_plugin index="0"/>
        <xacro:gazebo_sensor_plugin index="1"/>
        <xacro:gazebo_sensor_plugin index="2"/>
        <xacro:gazebo_sensor_plugin index="3"/>
        <xacro:gazebo_sensor_plugin index="4"/>
        <xacro:gazebo_sensor_plugin index="5"/>
        <xacro:gazebo_sensor_plugin index="6"/>
        <xacro:gazebo_sensor_plugin index="7"/>
        <xacro:gazebo_sensor_plugin index="8"/>
    </xacro:macro>
</robot>
