<?xml version="1.0"?> <!-- 这是版本提示 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">
    <xacro:macro name ="base_link" params="length radius">
        <!-- 机器人的身体 -->
        <link name="base_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 -->
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!-- 材质颜色 -->
                <material name="white">
                    <color rgba="1.0 1.0 1.0 0.5"/>
                </material>
            </visual>
        </link>
    </xacro:macro>

    <xacro:macro name ="IMU_link" params="imu_name xyz">
        <!-- 机器人的IMU，惯性测量单元传感器 -->
        <link name="${imu_name}_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心偏移和旋转 -->
                <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 立方体 -->
                    <box size="0.02 0.02 0.02"/>
                </geometry>
                <!-- 材质颜色 -->
                <material name="black">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </visual>
        </link>

        <!-- 机器人的关节，用于组合机器人的部件, type是可动还是不可动 -->
        <joint name="${imu_name}_joint" type="fixed">
            <!-- 关节的父部件 -->
            <parent link="base_link"/>
            <!-- 关节的子部件 -->
            <child link="${imu_name}_link"/>
            <!-- 关节的偏移和旋转 -->
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>

    <xacro:base_link length="0.12" radius="0.1"/>
    <xacro:IMU_link imu_name="IMU" xyz="0.0 0.0 0.03"/>
    <xacro:IMU_link imu_name="IMU2" xyz="0.0 0.0 -0.03"/>
</robot>